# SENTINEL-X environment configuration
# Copy to .env and fill values. Never commit .env (SEC-6).

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── PostgreSQL ──
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sentinel
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── API ──
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=CHANGE_ME

# ── Sensor ──
CAPTURE_INTERFACE=eth0

# ── Lab mode (SEC-7: outbound self-test, disabled by default) ──
LAB_MODE=false
